{
  "info": {
    "name": "Go Commerce - End to End Testing",
    "description": "Automated authentication, seller, buyer, product and order testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "e8fc38b6-78a1-4252-a1d3-c18a9f473be0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "sellerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "sellerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "buyerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "buyerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "cancelOrderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Register Seller",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"seller1@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"seller\",\n  \"name\": \"Seller One\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Seller registration successful', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('sellerToken', data.token);",
              "pm.collectionVariables.set('sellerId', data.user.seller_id);",
              "console.log('SELLER_ID:', data.user.seller_id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 - Register Buyer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"buyer1@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"buyer\",\n  \"name\": \"Buyer One\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Buyer registration successful', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('buyerToken', data.token);",
              "pm.collectionVariables.set('buyerId', data.user.buyer_id);",
              "console.log('BUYER_ID:', data.user.buyer_id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 - Seller Creates Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sellerToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"14 inch\",\n  \"price\": 49950,\n  \"stock\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Product created', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('productId', data.id);",
              "console.log('PRODUCT_ID:', data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "04 - Buyer Creates Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"product_id\": {{productId}},\n      \"quantity\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Order created', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('orderId', data.id);",
              "console.log('ORDER_ID:', data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "05 - Buyer Gets Order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{orderId}}"
          ]
        }
      }
    },
    {
      "name": "06 - Buyer Gets All Their Orders",
